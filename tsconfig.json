{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "allowJs": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "incremental": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "plugins": [{ "name": "next" }],
    "paths": {
      "@meridian-mdm/ui": ["./packages/ui/src"],
      "@meridian-mdm/ui/*": ["./packages/ui/src/*"],
      "@meridian-mdm/graphql": ["./packages/graphql/src"],
      "@meridian-mdm/graphql/*": ["./packages/graphql/src/*"],
      "@meridian-mdm/database": ["./packages/database/src"],
      "@meridian-mdm/mcp-server": ["./packages/mcp-server/src"],
      "@meridian-mdm/config": ["./packages/config"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx", "**/*.mts"],
  "exclude": ["node_modules", "dist", ".next", ".turbo"]
}
