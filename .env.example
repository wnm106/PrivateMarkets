# Supabase Configuration
SUPABASE_URL=http://localhost:54321
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
SUPABASE_PROJECT_ID=your-project-id

# Database Connection (for migrations)
DATABASE_URL=postgresql://postgres:postgres@localhost:54322/postgres
DATABASE_POOL_SIZE=10

# GraphQL API
GRAPHQL_ENDPOINT=http://localhost:4000/graphql
GRAPHQL_SUBSCRIPTION_ENDPOINT=ws://localhost:4000/graphql

# AI Provider Keys
# The Next.js app reads these from apps/web/.env.local (server-only).
ANTHROPIC_API_KEY=your-anthropic-key-here
OPENAI_API_KEY=your-openai-key-here
GEMINI_API_KEY=your-gemini-key-here
GOOGLE_AI_API_KEY=your-google-ai-key-here

# Cloudflare
CLOUDFLARE_ACCOUNT_ID=your-account-id
CLOUDFLARE_API_TOKEN=your-api-token

# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_GRAPHQL_ENDPOINT=http://localhost:4000/graphql
NODE_ENV=development

# Logging
LOG_LEVEL=info

# LlamaParse (https://cloud.llamaindex.ai). Reads complex PDFs, scans, and Word files for the data specialist.
# Leave blank to keep documents on Azure Document Intelligence or the built-in PDF text reader.
LLAMA_CLOUD_API_KEY=

# Job worker (packages/worker). All optional. See docs/JOBS.md.
WORKER_CONCURRENCY=5
WORKER_LEASE_SECONDS=300
WORKER_POLL_MS=5000
# Testing only: lets feed connectors reach servers on this machine. Never set it in a deployed worker.
# FEED_ALLOW_PRIVATE_HOSTS=true

# Workflows (docs/WORKFLOWS.md). Steps run as each client's workflow service account, which the
# worker reaches with the service role key above. No extra secret is needed.
# Optional. The model and thinking depth for agent steps.
# WORKFLOW_AGENT_MODEL=claude-opus-5-5
# WORKFLOW_AGENT_EFFORT=high
