{
  "name": "@tapestrai/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "npm --prefix ../excel-addin run build",
    "dev": "next dev",
    "prebuild": "npm --prefix ../excel-addin run build",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test \"lib/**/*.test.ts\"",
    "clean": "rm -rf .next .open-next .wrangler .turbo node_modules",
    "cf:build": "opennextjs-cloudflare build",
    "cf:preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "cf:deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf:typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "dependencies": {
    "@graphql-typed-document-node/core": "^3.2.0",
    "@opennextjs/cloudflare": "^1.20.17",
    "@supabase/ssr": "^0.5.2",
    "@supabase/supabase-js": "^2.39.0",
    "@urql/core": "^5.0.0",
    "@xyflow/react": "^13.0.0",
    "ag-grid-community": "^36.2.0",
    "ag-grid-enterprise": "^36.2.0",
    "ag-grid-react": "^36.2.0",
    "clsx": "^2.1.0",
    "date-fns": "^3.0.0",
    "dotenv": "^16.4.0",
    "graphql": "^16.8.0",
    "graphql-yoga": "^5.24.1",
    "katex": "^0.16.22",
    "next": "^16.4.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^2.2.0",
    "unpdf": "^1.9.1",
    "urql": "^4.0.0",
    "xlsx": "^0.18.5",
    "zod": "^3.22.0",
    "zustand": "^4.4.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.4.6",
    "postcss": "^8.4.0",
    "tailwindcss": "^3.4.0",
    "tsx": "^4.7.0",
    "typescript": "^5.7.0",
    "wrangler": "^4.165.0"
  }
}
