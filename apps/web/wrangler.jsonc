{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tapestrai-web",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    { "binding": "WORKER_SELF_REFERENCE", "service": "tapestrai-web" }
  ],
  "observability": { "enabled": true },
  // Error reports name their environment (packages/graphql/src/lib/error-report.ts).
  "vars": { "ERROR_REPORT_ENVIRONMENT": "production" },
  // Requests per person per minute for GraphQL, the assistant connector and
  // browser error reports (packages/graphql/src/lib/rate-limit.ts). A page view
  // makes 10 to 30 GraphQL calls, so 300 a minute leaves room for heavy use.
  "unsafe": {
    "bindings": [
      { "name": "RATE_LIMITER", "type": "ratelimit", "namespace_id": "1001", "simple": { "limit": 300, "period": 60 } }
    ]
  },
  // Secrets are set with `npx wrangler secret put <NAME>`, never written here:
  // SUPABASE_SERVICE_ROLE_KEY, ANTHROPIC_API_KEY, GEMINI_API_KEY,
  // LLAMA_CLOUD_API_KEY, VOYAGE_API_KEY, and ERROR_REPORT_DSN (optional).
  // NEXT_PUBLIC_* values are baked in at build time from .env.local / the build env.
  //
  // Staging: `npm run cf:deploy:staging`, with its own secrets
  // (`npx wrangler secret put <NAME> --env staging`) and its own Supabase project.
  // See docs/ENVIRONMENTS.md. Bindings and vars are not inherited, so each is repeated.
  "env": {
    "staging": {
      "name": "tapestrai-web-staging",
      "services": [
        { "binding": "WORKER_SELF_REFERENCE", "service": "tapestrai-web-staging" }
      ],
      "observability": { "enabled": true },
      "vars": { "ERROR_REPORT_ENVIRONMENT": "staging" },
      "unsafe": {
        "bindings": [
          { "name": "RATE_LIMITER", "type": "ratelimit", "namespace_id": "1011", "simple": { "limit": 300, "period": 60 } }
        ]
      }
    }
  }
}
