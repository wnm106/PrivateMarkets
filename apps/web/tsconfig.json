{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./*"
      ],
      "@tapestrai/ui": [
        "../../packages/ui/src"
      ],
      "@tapestrai/ui/*": [
        "../../packages/ui/src/*"
      ],
      "@tapestrai/surface-sdk": [
        "../../packages/surface-sdk/src"
      ],
      "@surfaces/*": [
        "../../surfaces/*"
      ],
      "@tapestrai/surface-sdk/*": [
        "../../packages/surface-sdk/src/*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
