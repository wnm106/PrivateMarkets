<?xml version="1.0" encoding="UTF-8"?>
<!--
  Tapestry Excel add-in. Generated by apps/excel-addin/scripts/build.mjs for __ORIGIN__.
  Deploy it in the Microsoft 365 admin center (Integrated apps > Upload custom apps),
  or sideload it for testing. See docs/EXCEL_ADDIN.md.
-->
<OfficeApp xmlns="http://schemas.microsoft.com/office/appforoffice/1.1"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xmlns:bt="http://schemas.microsoft.com/office/officeappbasictypes/1.0"
           xmlns:ov="http://schemas.microsoft.com/office/taskpaneappversionoverrides"
           xsi:type="TaskPaneApp">
  <Id>__ADDIN_ID__</Id>
  <Version>__VERSION__</Version>
  <ProviderName>tapestr.ai</ProviderName>
  <DefaultLocale>en-US</DefaultLocale>
  <DisplayName DefaultValue="__DISPLAY_NAME__"/>
  <Description DefaultValue="Pull Tapestry data into Excel with =TAP(attribute, record, as of). Each person signs in with their own account."/>
  <IconUrl DefaultValue="__ORIGIN__/excel/addin/assets/icon-32.png"/>
  <HighResolutionIconUrl DefaultValue="__ORIGIN__/excel/addin/assets/icon-64.png"/>
  <SupportUrl DefaultValue="__ORIGIN__/excel/addin/help.html"/>
  <AppDomains>
    <AppDomain>__ORIGIN__</AppDomain>
  </AppDomains>
  <Hosts>
    <Host Name="Workbook"/>
  </Hosts>
  <Requirements>
    <Sets DefaultMinVersion="1.1">
      <Set Name="SharedRuntime" MinVersion="1.1"/>
    </Sets>
  </Requirements>
  <DefaultSettings>
    <SourceLocation DefaultValue="__ORIGIN__/excel/addin/taskpane.html"/>
  </DefaultSettings>
  <Permissions>ReadWriteDocument</Permissions>
  <VersionOverrides xmlns="http://schemas.microsoft.com/office/taskpaneappversionoverrides" xsi:type="VersionOverridesV1_0">
    <Hosts>
      <Host xsi:type="Workbook">
        <Runtimes>
          <Runtime resid="Taskpane.Url" lifetime="long"/>
        </Runtimes>
        <AllFormFactors>
          <ExtensionPoint xsi:type="CustomFunctions">
            <Script>
              <SourceLocation resid="Functions.Script.Url"/>
            </Script>
            <Page>
              <SourceLocation resid="Taskpane.Url"/>
            </Page>
            <Metadata>
              <SourceLocation resid="Functions.Metadata.Url"/>
            </Metadata>
            <Namespace resid="Functions.Namespace"/>
          </ExtensionPoint>
        </AllFormFactors>
        <DesktopFormFactor>
          <GetStarted>
            <Title resid="GetStarted.Title"/>
            <Description resid="GetStarted.Description"/>
            <LearnMoreUrl resid="Help.Url"/>
          </GetStarted>
          <FunctionFile resid="Taskpane.Url"/>
          <ExtensionPoint xsi:type="PrimaryCommandSurface">
            <OfficeTab id="TabHome">
              <Group id="Tapestry.Group">
                <Label resid="Group.Label"/>
                <Icon>
                  <bt:Image size="16" resid="Icon.16x16"/>
                  <bt:Image size="32" resid="Icon.32x32"/>
                  <bt:Image size="80" resid="Icon.80x80"/>
                </Icon>
                <Control xsi:type="Button" id="Tapestry.Pane">
                  <Label resid="PaneButton.Label"/>
                  <Supertip>
                    <Title resid="PaneButton.Label"/>
                    <Description resid="PaneButton.Tooltip"/>
                  </Supertip>
                  <Icon>
                    <bt:Image size="16" resid="Icon.16x16"/>
                    <bt:Image size="32" resid="Icon.32x32"/>
                    <bt:Image size="80" resid="Icon.80x80"/>
                  </Icon>
                  <Action xsi:type="ShowTaskpane">
                    <TaskpaneId>Tapestry.Taskpane</TaskpaneId>
                    <SourceLocation resid="Taskpane.Url"/>
                  </Action>
                </Control>
                <Control xsi:type="Button" id="Tapestry.Refresh">
                  <Label resid="RefreshButton.Label"/>
                  <Supertip>
                    <Title resid="RefreshButton.Label"/>
                    <Description resid="RefreshButton.Tooltip"/>
                  </Supertip>
                  <Icon>
                    <bt:Image size="16" resid="Refresh.16x16"/>
                    <bt:Image size="32" resid="Refresh.32x32"/>
                    <bt:Image size="80" resid="Refresh.80x80"/>
                  </Icon>
                  <Action xsi:type="ExecuteFunction">
                    <FunctionName>refreshTap</FunctionName>
                  </Action>
                </Control>
              </Group>
            </OfficeTab>
          </ExtensionPoint>
        </DesktopFormFactor>
      </Host>
    </Hosts>
    <Resources>
      <bt:Images>
        <bt:Image id="Icon.16x16" DefaultValue="__ORIGIN__/excel/addin/assets/icon-16.png"/>
        <bt:Image id="Icon.32x32" DefaultValue="__ORIGIN__/excel/addin/assets/icon-32.png"/>
        <bt:Image id="Icon.80x80" DefaultValue="__ORIGIN__/excel/addin/assets/icon-80.png"/>
        <bt:Image id="Refresh.16x16" DefaultValue="__ORIGIN__/excel/addin/assets/refresh-16.png"/>
        <bt:Image id="Refresh.32x32" DefaultValue="__ORIGIN__/excel/addin/assets/refresh-32.png"/>
        <bt:Image id="Refresh.80x80" DefaultValue="__ORIGIN__/excel/addin/assets/refresh-80.png"/>
      </bt:Images>
      <bt:Urls>
        <bt:Url id="Functions.Script.Url" DefaultValue="__ORIGIN__/excel/addin/taskpane.js"/>
        <bt:Url id="Functions.Metadata.Url" DefaultValue="__ORIGIN__/excel/addin/functions.json"/>
        <bt:Url id="Taskpane.Url" DefaultValue="__ORIGIN__/excel/addin/taskpane.html"/>
        <bt:Url id="Help.Url" DefaultValue="__ORIGIN__/excel/addin/help.html"/>
      </bt:Urls>
      <bt:ShortStrings>
        <bt:String id="Functions.Namespace" DefaultValue="TAPESTRY"/>
        <bt:String id="GetStarted.Title" DefaultValue="Tapestry is ready"/>
        <bt:String id="Group.Label" DefaultValue="Tapestry"/>
        <bt:String id="PaneButton.Label" DefaultValue="Tapestry"/>
        <bt:String id="RefreshButton.Label" DefaultValue="Refresh TAP"/>
      </bt:ShortStrings>
      <bt:LongStrings>
        <bt:String id="GetStarted.Description" DefaultValue="Open Home &gt; Tapestry to sign in and build =TAP formulas."/>
        <bt:String id="PaneButton.Tooltip" DefaultValue="Sign in, then search attributes and records to build a =TAP formula."/>
        <bt:String id="RefreshButton.Tooltip" DefaultValue="Recalculate every =TAP formula in this workbook."/>
      </bt:LongStrings>
    </Resources>
  </VersionOverrides>
</OfficeApp>
