{
  "name": "@tapestrai/excel-addin",
  "version": "1.0.0",
  "private": true,
  "description": "Excel add-in: the =TAP formula and its formula builder. Served by the web app at /excel/addin/.",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "icons": "node scripts/icons.mjs",
    "clean": "rm -rf ../web/public/excel/addin .turbo"
  },
  "dependencies": {
    "@tapestrai/graphql": "*"
  },
  "devDependencies": {
    "@types/custom-functions-runtime": "^1.6.13",
    "@types/office-js": "^1.0.618",
    "esbuild": "^0.28.0",
    "typescript": "^5.7.0",
    "vitest": "^1.6.0"
  }
}
