{
  "name": "tapestrai",
  "version": "0.1.0",
  "private": true,
  "description": "Bi-temporal financial Master Data Management platform for private markets investments",
  "workspaces": [
    "apps/*",
    "packages/*",
    "surfaces/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "lint:surfaces": "eslint -c surfaces/eslint.config.mjs \"surfaces/*/src/**/*.{ts,tsx}\"",
    "guard": "node scripts/guard/check-static.mjs",
    "guard:db": "tsx scripts/guard/check-db.ts",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "typecheck:ci": "npm run typecheck --workspaces --if-present",
    "test:ci": "npm run test --workspace @tapestrai/web && npm exec --workspace @tapestrai/graphql -- vitest run && npm exec --workspace @tapestrai/mcp-server -- vitest run && npm exec --workspace @tapestrai/worker -- vitest run && npm exec --workspace @tapestrai/inbound-email -- vitest run && npm exec --workspace @tapestrai/excel-addin -- vitest run",
    "db:migrate": "supabase db push",
    "db:seed": "supabase db seed",
    "db:reset": "supabase db reset --local --yes",
    "db:replay": "bash scripts/db-replay/replay.sh",
    "test:db": "tsx scripts/db-tests/capacity-parity.ts",
    "db:studio": "supabase studio",
    "generate:graphql": "graphql-codegen --config codegen.ts",
    "clean": "turbo run clean && rm -rf node_modules"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "turbo": "^2.3.0",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "packageManager": "npm@10.9.0",
  "dependencies": {
    "pg": "^8.23.0"
  }
}
